{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email', 'phone'])"
      }
    },
    "orders": {
      ".indexOn": [
        "uid",
        "timestamp"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      "$orderKey": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('total').isNumber() && newData.child('customerName').isString() && newData.child('items').exists()))"
      }
    },
    "analytics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "dailyOrdersCounter": {
        "$day": {
          ".read": "auth != null",
          ".write": "auth != null && newData.isNumber()"
        }
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "customProducts": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "siteSettings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "notifications": {
      ".indexOn": [
        "timestamp"
      ],
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "reviews": {
      ".indexOn": [
        "timestamp"
      ],
      ".read": true,
      "$reviewKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('comment').isString() && newData.child('comment').val().length <= 600)"
      }
    },
    "contacts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$contactKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('message').isString() && newData.child('message').val().length <= 1000)"
      }
    },
    "userNotifications": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ],
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
